{
  "name": "hajj-app",
  "private": true,
  "version": "1.0.0",
  "description": "Application de gestion de pèlerinage Hajj pour pèlerins et agences camerounaises",
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/web",
    "packages/mobile"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=packages/backend",
    "dev:web": "npm run dev --workspace=packages/web",
    "dev:mobile": "npm run start --workspace=packages/mobile",
    "build:web": "npm run build --workspace=packages/web"
  }
}